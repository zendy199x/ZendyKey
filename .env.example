# ZendyKey Environment Variables
# Copy this file to .env and fill in your values (all are OPTIONAL)

# ============ Apple Notarization (Optional) ============
# Only needed if you want to distribute outside of GitHub/direct download
# Your Apple ID email
APPLE_ID=your-apple-id@example.com

# App-specific password (generate at appleid.apple.com)
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Apple Developer Team ID
APPLE_TEAM_ID=XXXXXXXXXX

# Code signing identity (Developer ID Application: Your Name)
# Leave empty to build without signing
SIGNING_IDENTITY=

# ============ Sparkle Updates (Optional) ============
# EdDSA Private Key for signing updates
# Generate with: /path/to/Sparkle/bin/generate_keys
SPARKLE_PRIVATE_KEY=

# ============ Build Options (Optional) ============
# All enabled by default - uncomment to disable

# ENABLE_CODESIGN=false         # Disable code signing (default: auto-detect)
# ENABLE_NOTARIZE=false         # Disable notarization (default: false)
# ENABLE_DMG=true               # Enable DMG creation
# ENABLE_ZENDYKEYIM=true        # Enable ZendyKeyIM build
# ENABLE_SPARKLE_SIGN=false     # Disable Sparkle signing
# ENABLE_APPCAST=false          # Disable appcast generation

# ============ Build Without Apple Developer Account ============
# This is the default! Just run:
#   ./build_release.sh --dmg
#
# The app will build and create a DMG without code signing.
# Users may need to right-click > Open on first launch.
